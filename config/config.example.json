{
  "app_name": "InsightFlow",
  "version": "1.0.2",
  "timezone": "Asia/Shanghai",
  "source_dir": "examples/raw",
  "output_dir": "output",
  "log_dir": "logs",
  "state_dir": "state",
  "schedule_time": "09:30",
  "target_date_mode": "previous_day",
  "date_order": "month_first",
  "recursive_scan": true,
  "include_extensions": [".xlsx", ".xls", ".csv"],
  "max_file_mb": 50,
  "max_rows_per_file": 200000,
  "header_scan_rows": 20,
  "outlier_iqr_k": 1.5,
  "top_n": 8,
  "max_charts": 8,
  "comparison": {
    "enabled": true,
    "lookback_days": 1
  },
  "report": {
    "title": "每日经营数据洞察报告",
    "company": "InsightFlow · Portfolio Demo",
    "max_table_rows": 100,
    "accent": "#2563eb"
  },
  "scheduler": {
    "task_name": "InsightFlow_Daily_0930",
    "grace_minutes": 180
  },
  "llm": {
    "enabled": false,
    "features": {
      "semantic": false,
      "plan": false,
      "execute": false,
      "narrative": false
    },
    "force_rules": false,
    "adoption": {
      "semantic": "shadow",
      "plan": "shadow",
      "execute": "shadow",
      "narrative": "shadow"
    },
    "budget": {
      "per_table_cny": 5.0,
      "batch_cny": 20.0
    },
    "timeout": {
      "request_seconds": 60,
      "sandbox_seconds": 10
    },
    "sandbox": {
      "memory_mb": 512,
      "max_input_rows": 200000
    },
    "retry": {
      "structured_output": 2,
      "transport": 2
    },
    "warn_prompt_tokens": 8000
  }
}
