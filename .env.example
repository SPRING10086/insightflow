# 复制为 .env 并填写；.env 已被 .gitignore 忽略，切勿入库
# 模型标识必须用实测可用的 API 名称，不要凭猜测填写
INSIGHTFLOW_LLM_MODEL=
DEEPSEEK_API_KEY=
# 单价：人民币 / 百万 tokens（按官方定价填写，代码不内置默认单价）
INSIGHTFLOW_LLM_PRICE_IN=
INSIGHTFLOW_LLM_PRICE_OUT=
# 可选
INSIGHTFLOW_LLM_BASE_URL=https://api.deepseek.com
INSIGHTFLOW_LLM_TIMEOUT=60
INSIGHTFLOW_LLM_RETRIES=2
INSIGHTFLOW_LLM_MAX_TOKENS=2000
